<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtre d'exclusion SpotBugs pour le projet Robi.
  On exclut les faux positifs connus dans un contexte académique.
-->
<FindBugsFilter>

  <!-- Exclure les bugs de sérialisation (pas de Serializable dans ce projet) -->
  <Match>
    <Bug category="MALICIOUS_CODE"/>
    <Class name="~exercice[456]\..*"/>
  </Match>

  <!-- Exclure les avertissements sur les champs exposés dans les classes "data" -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Class name="~stree\.parser\..*"/>
  </Match>

  <!-- Ignorer les null-check sur les retours du serveur HTTP (com.sun.net.httpserver) -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    <Class name="exercice7.server.SExpressionServer"/>
  </Match>

  <!-- Tolérer l'utilisation de System.out/err dans les exemples -->
  <Match>
    <Bug pattern="DM_DEFAULT_ENCODING"/>
  </Match>

</FindBugsFilter>